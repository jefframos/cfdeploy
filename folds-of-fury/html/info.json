  {
    "type": "table",
    "entries": [
      {
        "text": "Move the paper plane around the board to aim your weapon at enemies.",
        "image": "images/folds1.png",
        "maxImageHeight": 80,
        "imagePosition": "left",
        "imageHorizontalAlign": "right",
        "textHorizontalAlign": "left",
        "textVerticalAlign": "middle"
      },
      {
        "text": "Enemies have different behaviors, memorize these patterns to predict where you will be safe.",
        "image": "images/folds2.png",
        "maxImageHeight": 80,
        "imagePosition": "left",
        "imageHorizontalAlign": "right",
        "textHorizontalAlign": "left",
        "textVerticalAlign": "middle"
      },
      {
        "text": "Basic enemies drop blue crystals, collect these to unlock powerups.",
        "image": "images/folds3.png",
        "maxImageHeight": 80,
        "imagePosition": "left",
        "imageHorizontalAlign": "right",
        "textHorizontalAlign": "left",
        "textVerticalAlign": "middle"
      },
      {
        "text": "Elite enemies have a psychedelic aura and are stronger than regular enemies.",
