  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "...once filled you are rewarded with three powerups to choose from."
      }
    ]
  },
  {
    "type": "table",
    "entries": [
      {
        "text": "Increase your shooting speed and damage dealt by upgrading to the Papercut.",
