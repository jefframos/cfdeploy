        "maxImageHeight": 80,
        "imagePosition": "left",
        "imageHorizontalAlign": "right",
        "textHorizontalAlign": "left",
        "textVerticalAlign": "middle"
      },
      {
        "text": "Drop a fish on a Catto to make it GROW one size larger.",
        "image": "images/catto-fish.png",
        "maxImageHeight": 80,
        "imagePosition": "left",
        "imageHorizontalAlign": "right",
        "textHorizontalAlign": "left",
        "textVerticalAlign": "middle"
      },
      {
        "text": "Use the bottle to SPLIT up a big Catto into smaller ones!",
        "image": "images/catto-bottle.png",
