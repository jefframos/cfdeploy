        "maxImageHeight": 80,
        "imagePosition": "left",
        "imageHorizontalAlign": "right",
        "textHorizontalAlign": "left",
        "textVerticalAlign": "middle"
      },
      {
        "text": "When two Cattos touch they form a bigger Catto. Keep merging and see how big you can go!",
        "image": "images/catto2-5.png",
        "maxImageHeight": 80,
        "imagePosition": "left",
        "imageHorizontalAlign": "right",
        "textHorizontalAlign": "left",
        "textVerticalAlign": "middle"
      },
      {
        "text": "Plan your merges by keeping an eye on which Catto is up next.",
        "image": "images/catto2.png",
