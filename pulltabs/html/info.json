[
  {
    "type": "tiledImage",
    "src": "images/pattern.png",
    "height": 250,
    "backgroundColor": "#000",
    "centeredContent": {
      "src": "images/logo.png",
      "imageHeight": 200,
      "textColor": "#f0f0f0"
    }
  },
  {
    "redirectId": "game-explanation",
    "name": "GAME EXPLANATION",
    "type": "title",
    "text": "Game Explanation",
    "spaceAfter": 30
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "Every game generates a new board"
      }
    ]
  },
  {
    "type": "table",
    "entries": [
      {
        "text": "The board is 5x5 consisting of a variety of tiles:",
        "image": "images/fatui_01.png",
        "maxImageHeight": 160,
        "imagePosition": "left",
        "imageHorizontalAlign": "right",
        "textHorizontalAlign": "left",
        "textVerticalAlign": "middle"
      },
      {
        "text": "Starting Tile  - Randomised point where the player begins",
        "image": "images/fatui_02.png",
        "maxImageHeight": 80,
        "imagePosition": "left",
        "imageHorizontalAlign": "right",
        "textHorizontalAlign": "left",
        "textVerticalAlign": "middle"
      },
      {
        "text": "Pitfall Tile  - Impassible tiles, randomly around the board",
        "image": "images/fatui_03.png",
        "maxImageHeight": 80,
        "imagePosition": "left",
        "imageHorizontalAlign": "right",
        "textHorizontalAlign": "left",
        "textVerticalAlign": "middle"
      },
      {
        "text": "Regular Tile -  Does nothing. Becomes a highlighted tile when next to a Gem Tile or Starting Tile",
        "image": "images/fatui_04.png",
        "maxImageHeight": 80,
        "imagePosition": "left",
        "imageHorizontalAlign": "right",
        "textHorizontalAlign": "left",
        "textVerticalAlign": "middle"
      },
      {
        "text": "Highlighted Tile - Can be tapped to reveal either a Gem Tile or a Bomb Tile",
        "image": "images/fatui_05.png",
        "maxImageHeight": 80,
        "imagePosition": "left",
        "imageHorizontalAlign": "right",
        "textHorizontalAlign": "left",
        "textVerticalAlign": "middle"
      },
      {
        "text": "Gem Tile - Shows one of three gems. When revealed, the player’s payout multiplier increases by one stage",
        "image": "images/fatui_06.png",
        "maxImageHeight": 80,
        "imagePosition": "left",
        "imageHorizontalAlign": "right",
        "textHorizontalAlign": "left",
        "textVerticalAlign": "middle"
      },
      {
        "text": "Bomb Tile - When revealed, the player loses the game",
        "image": "images/fatui_07.png",
        "maxImageHeight": 80,
        "imagePosition": "left",
        "imageHorizontalAlign": "right",
        "textHorizontalAlign": "left",
        "textVerticalAlign": "middle"
      }
    ],
    "spaceAfter": 30
  },
  {
    "type": "image",
    "src": "images/fatui_09.png",
    "imagePosition": "center",
    "imageHorizontalAlign": "center",
    "imageHeight": 120,
    "spaceAfter": 0
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "The Multiplier Track shows the currently earned multiplier, and that the maximum multiplier is x1000"
      }
    ]
  },
  {
    "type": "image",
    "src": "images/fatui_10.png",
    "imagePosition": "center",
    "imageHorizontalAlign": "center",
    "imageHeight": 120,
    "spaceAfter": 0
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "The settle button allows you to end the game with the current multiplier, leaving the ‘Win Amount’ shown on the left"
      }
    ]
  },
  {
    "redirectId": "how-to-play",
    "name": "HOW TO PLAY",
    "type": "title",
    "text": "How To Play",
    "spaceAfter": 30
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "At the start of each game, you must choose your play amount and currency"
      }
    ]
  },
  {
    "type": "image",
    "src": "images/fatui_11.png",
    "imagePosition": "center",
    "imageHorizontalAlign": "center",
    "imageHeight": 300,
    "spaceAfter": 0
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "Then press continue"
      }
    ]
  },
  {
    "type": "image",
    "src": "images/fatui_12.png",
    "imagePosition": "center",
    "imageHorizontalAlign": "center",
    "imageHeight": 200,
    "spaceAfter": 0
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "A random board is generated"
      }
    ]
  },
  {
    "type": "image",
    "src": "images/fatui_13.png",
    "imagePosition": "center",
    "imageHorizontalAlign": "center",
    "imageHeight": 200,
    "spaceAfter": 0
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "You may then select a highlighted tile to reveal"
      }
    ]
  },
  {
    "type": "image",
    "src": "images/fatui_14.png",
    "imagePosition": "center",
    "imageHorizontalAlign": "center",
    "imageHeight": 200,
    "spaceAfter": 0
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "The tile will then be revealed as a bomb, or a gem"
      }
    ]
  },
  {
    "type": "image",
    "src": "images/fatui_15.png",
    "imagePosition": "center",
    "imageHorizontalAlign": "center",
    "imageHeight": 200,
    "spaceAfter": 0
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "If a bomb is selected, then the game ends, and you lose"
      }
    ]
  },
  {
    "type": "image",
    "src": "images/fatui_16.png",
    "imagePosition": "center",
    "imageHorizontalAlign": "center",
    "imageHeight": 120,
    "spaceAfter": 0
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "If a gem is revealed then your multiplier increases"
      }
    ]
  },
  {
    "type": "image",
    "src": "images/fatui_17.png",
    "imagePosition": "center",
    "imageHorizontalAlign": "center",
    "imageHeight": 120,
    "spaceAfter": 0
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "As well as your potential reward"
      }
    ]
  },
  {
    "type": "image",
    "src": "images/fatui_18.png",
    "imagePosition": "center",
    "imageHorizontalAlign": "center",
    "imageHeight": 120,
    "spaceAfter": 0
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "The Settle button is revealed, and the game continues"
      }
    ]
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "The game then continues until either a bomb is struck, a bomb is reached, or you achieve the maximum multiplier"
      }
    ]
  },
  {
    "type": "image",
    "src": "images/fatui_19.png",
    "imagePosition": "center",
    "imageHorizontalAlign": "center",
    "imageHeight": 200,
    "spaceAfter": 0
  },
  {
    "redirectId": "rewards",
    "name": "REWARDS",
    "type": "title",
    "text": "Rewards",
    "spaceAfter": 30
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "Before each game, the player selects a play amount"
      }
    ]
  },
  {
    "type": "image",
    "src": "images/fatui_11.png",
    "imagePosition": "center",
    "imageHorizontalAlign": "center",
    "imageHeight": 300,
    "spaceAfter": 0
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "This amount is held until the player settles or loses"
      }
    ]
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "Each time you select a tile, you’ll either be shown a gem or a bomb"
      }
    ]
  },
  {
    "type": "image",
    "src": "images/fatui_07.png",
    "imagePosition": "center",
    "imageHorizontalAlign": "center",
    "imageHeight": 200,
    "spaceAfter": 0
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "If you get a bomb, then you lose your play amount and the game ends"
      }
    ]
  },
  {
    "type": "image",
    "src": "images/fatui_06.png",
    "imagePosition": "center",
    "imageHorizontalAlign": "center",
    "imageHeight": 200,
    "spaceAfter": 0
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "If you get a gem, then your multiplier increases and the game continues"
      }
    ]
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "After earning one gem, you gain the option to settle before selecting each tile. Doing so will reward you with your play amount multiplied by your multiplier"
      }
    ]
  },
  {
    "type": "image",
    "src": "images/fatui_18.png",
    "imagePosition": "center",
    "imageHorizontalAlign": "center",
    "imageHeight": 120,
    "spaceAfter": 0
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "This continues with increasing difficulty until you hit a bomb, settle, or reach the x1000 multiplier"
      }
    ]
  },
  {
    "redirectId": "paytables",
    "name": "PAYTABLES",
    "type": "title",
    "text": "Paytables",
    "spaceAfter": 30
  },
  {
    "type": "flexContainer",
    "content": [
      {
        "type": "text",
        "value": "The Main game's RTP depends on the round"
      }
    ]
  },
